rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health and connectivity check
    match /test/connection {
      allow read: if true;
    }

    // AutoFix Ops collections - Accessible to server-side ingestion pipelines
    // and authenticated operators validated on the client
    match /error_events/{eventId} {
      allow read, write: if true;
    }

    match /stage_transitions/{transitionId} {
      allow read, write: if true;
    }

    match /pull_requests/{prId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
