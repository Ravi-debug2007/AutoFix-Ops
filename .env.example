# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: GitHub Personal Access Token or App token with repo permissions
GITHUB_TOKEN=""

# SENTRY_WEBHOOK_SECRET: Secret for verifying Sentry webhook signatures
SENTRY_WEBHOOK_SECRET=""

# GITHUB_WEBHOOK_SECRET: Secret for verifying GitHub Actions HMAC-SHA256 signatures
GITHUB_WEBHOOK_SECRET=""

# LOG_SHIPPER_TOKEN: Bearer token for authenticating generic log-shipper ingestion
LOG_SHIPPER_TOKEN=""

# TELEGRAM_BOT_TOKEN: Bot token provided by @BotFather
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_WEBHOOK_SECRET: Secret token passed in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=""

# AUTH_ALLOWLIST: Comma-separated list of Google account emails permitted to access the dashboard
AUTH_ALLOWLIST="allampallyravikiran2007@gmail.com"
